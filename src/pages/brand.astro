---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';

const brandAssets = [
  {
    title: 'Primary Logo Mark (Square Badge)',
    description: 'Emblem resmi Veridion Studio berlatar rounded squircle dark obsidian dengan aksen border neon glow.',
    preview: '/brand/veridion-logo-mark.svg',
    downloadUrl: '/brand/veridion-logo-mark.svg',
    filename: 'veridion-logo-mark.svg',
    format: 'Vector SVG (512 × 512)',
    bgClass: 'bg-slate-950',
  },
  {
    title: 'Transparent Logo Mark',
    description: 'Emblem geometris arsitektur tanpa latar belakang, ideal untuk ditempel di dokumen, kaos, dan slide presentasi.',
    preview: '/brand/veridion-logo-mark-transparent.svg',
    downloadUrl: '/brand/veridion-logo-mark-transparent.svg',
    filename: 'veridion-logo-mark-transparent.svg',
    format: 'Vector SVG (Transparent)',
    bgClass: 'bg-slate-900/60',
  },
  {
    title: 'Horizontal Wordmark (Dark Mode)',
    description: 'Logo kombinasi horizontal lengkap dengan tipografi modern untuk website, video intro, dan kop surat gelap.',
    preview: '/brand/veridion-logo-horizontal.svg',
    downloadUrl: '/brand/veridion-logo-horizontal.svg',
    filename: 'veridion-logo-horizontal-dark.svg',
    format: 'Vector SVG (680 × 160)',
    bgClass: 'bg-[#070A12]',
  },
  {
    title: 'Horizontal Wordmark (Light Mode)',
    description: 'Versi horizontal berlatar terang untuk invoice, proposal cetak, kontrak kerja sama klien, dan surat resmi.',
    preview: '/brand/veridion-logo-horizontal-light.svg',
    downloadUrl: '/brand/veridion-logo-horizontal-light.svg',
    filename: 'veridion-logo-horizontal-light.svg',
    format: 'Vector SVG (Light Surface)',
    bgClass: 'bg-white',
  },
  {
    title: 'Favicon & App Icon',
    description: 'Icon browser tab dan PWA mobile berukuran presisi tinggi dengan visibilitas optimal di layar resolusi kecil.',
    preview: '/favicon.svg',
    downloadUrl: '/favicon.svg',
    filename: 'veridion-favicon.svg',
    format: 'Vector SVG (100 × 100)',
    bgClass: 'bg-slate-950',
  },
];

const colors = [
  { name: 'Emerald Prime', hex: '#10B981', rgb: '16, 185, 129', role: 'Warna identitas utama, pertumbuhan & keramahan hospitality' },
  { name: 'Cyan Architecture', hex: '#06B6D4', rgb: '6, 182, 212', role: 'Teknologi cloud, presisi sistem & sinkronisasi data' },
  { name: 'Obsidian Night', hex: '#070A12', rgb: '7, 10, 18', role: 'Latar kemewahan luxury dark, elegan & modern' },
  { name: 'Pearl Canvas', hex: '#F8FAFC', rgb: '248, 250, 252', role: 'Permukaan dokumen resmi, transparansi & kontras bersih' },
];
---

<Layout
  title="Brand Identity & Official Logo Kit | Veridion Studio"
  description="Download logo resmi Veridion Studio dalam format vector SVG resolusi tinggi. Panduan identitas visual, palet warna, dan aset branding Hospitality Tech Studio."
  lang="id"
>
  <Navbar lang="id" />

  <main class="flex-1 py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100 dark:bg-emerald-500/10 border border-emerald-300 dark:border-emerald-500/30 text-emerald-800 dark:text-emerald-400 text-xs font-bold mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>OFFICIAL BRAND KIT &amp; ASSETS</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
          Logo Resmi &amp; Identitas Visual <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 via-teal-400 to-cyan-500">Veridion Studio</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300">
          Unduh aset logo vektor resmi dalam berbagai varian format (Dark, Light, Transparent Mark, Horizontal Wordmark, dan Favicon).
        </p>
      </div>

      <!-- Assets Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
        {brandAssets.map((asset) => (
          <div class="rounded-3xl bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-xl flex flex-col justify-between group hover:border-emerald-500/40 transition-all duration-300">
            <div>
              <!-- Visual Preview Box -->
              <div class={`rounded-2xl ${asset.bgClass} border border-slate-200/50 dark:border-slate-800 p-8 flex items-center justify-center min-h-[200px] mb-6 relative overflow-hidden shadow-inner group-hover:scale-[1.01] transition-transform`}>
                <img
                  src={asset.preview}
                  alt={asset.title}
                  class="max-h-28 max-w-full object-contain filter drop-shadow-md"
                />
              </div>

              <!-- Info -->
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 transition-colors">
                    {asset.title}
                  </h3>
                  <span class="px-2.5 py-0.5 text-[11px] font-mono font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-md border border-slate-200 dark:border-slate-700">
                    {asset.format}
                  </span>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                  {asset.description}
                </p>
              </div>
            </div>

            <!-- Download Button -->
            <div class="pt-6 mt-6 border-t border-slate-100 dark:border-slate-800/80">
              <a
                href={asset.downloadUrl}
                download={asset.filename}
                class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-slate-950 font-bold text-xs shadow-md shadow-emerald-500/20 active:scale-[0.98] transition-all cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>Unduh File ({asset.filename})</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Color Palette Guide -->
      <div class="rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-8 sm:p-10 shadow-xl mb-16">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-2">
          Palet Warna Brand
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mb-8">
          Kombinasi warna signature yang mencerminkan kemewahan resort alam dan kecanggihan rekayasa software.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {colors.map((c) => (
            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 p-4 space-y-3 bg-slate-50/50 dark:bg-slate-950/40">
              <div
                class="h-20 rounded-xl shadow-md border border-black/10"
                style={`background-color: ${c.hex};`}
              ></div>
              <div>
                <p class="text-sm font-bold text-slate-900 dark:text-white">{c.name}</p>
                <p class="text-xs font-mono font-semibold text-emerald-600 dark:text-emerald-400 mt-0.5">{c.hex}</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">{c.role}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Back to Home -->
      <div class="text-center">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Kembali ke Halaman Utama</span>
        </a>
      </div>

    </div>
  </main>

  <Footer lang="id" />
</Layout>
