---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import OtaSavingsCalculator from '../components/sections/OtaSavingsCalculator.astro';
import PortfolioCaseStudy from '../components/sections/PortfolioCaseStudy.astro';
import HospitalityStandards from '../components/sections/HospitalityStandards.astro';
import IndustrySolutions from '../components/sections/IndustrySolutions.astro';
import HowWeWork from '../components/sections/HowWeWork.astro';
import EarlyPartner from '../components/sections/EarlyPartner.astro';
import AppRequestWizard from '../components/sections/AppRequestWizard.astro';
import FAQ from '../components/sections/FAQ.astro';
import Footer from '../components/sections/Footer.astro';
---

<Layout
  title="Veridion Studio | Hospitality Tech Studio — Direct Booking Engine & Villa PMS"
  description="Veridion Studio: Dedicated Hospitality Tech Studio untuk Boutique Hotel, Luxury Villa, dan Eco-Resort. Direct Booking Engine mandiri tanpa komisi OTA 15-20%, 2-Way iCal Sync, Cloud PMS Front Desk, dan WhatsApp Concierge."
  lang="id"
>
  <Navbar lang="id" />
  <main class="flex-1">
    <Hero lang="id" />
    <OtaSavingsCalculator lang="id" />
    <PortfolioCaseStudy lang="id" />
    <HospitalityStandards lang="id" />
    <IndustrySolutions lang="id" />
    <HowWeWork lang="id" />
    <EarlyPartner lang="id" />
    <AppRequestWizard lang="id" />
    <FAQ lang="id" />
  </main>
  <Footer lang="id" />
</Layout>
