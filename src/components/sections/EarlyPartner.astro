---
import { earlyPartnerProgram, pilotTerms } from '../../data/content';
import { earlyPartnerProgramEn, pilotTermsEn } from '../../data/content-en';
import type { Language } from '../../i18n/ui';

interface Props {
  lang?: Language;
}

const { lang = 'id' } = Astro.props;
const prog = lang === 'en' ? earlyPartnerProgramEn : earlyPartnerProgram;
const terms = lang === 'en' ? pilotTermsEn : pilotTerms;
---

<section id="early-partner" class="py-24 md:py-32 relative bg-gradient-to-b from-slate-100 via-emerald-50/40 to-slate-100 dark:from-[#070A12] dark:via-emerald-950/20 dark:to-[#070A12] border-y border-emerald-500/20 overflow-hidden transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-emerald-500/30 bg-white/95 dark:bg-slate-900/90 p-8 sm:p-12 lg:p-16 relative shadow-2xl backdrop-blur-xl">
      
      <!-- Ambient Glow Decor -->
      <div class="absolute top-0 right-1/4 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Top Row: Overview & Slots -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Left: Explanations (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100 dark:bg-emerald-500/20 border border-emerald-300 dark:border-emerald-500/40 text-emerald-800 dark:text-emerald-300 text-xs font-bold tracking-wide">
            <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-ping"></span>
            <span>{lang === 'en' ? 'HOSPITALITY PILOT PARTNERSHIP (T&CS APPLY)' : 'PROGRAM KEMITRAAN PILOT (S&K BERLAKU)'}</span>
          </div>

          <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 dark:text-white leading-tight tracking-tight">
            {lang === 'en' ? (
              <>100% Free Development Fee for the <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-cyan-600 dark:from-emerald-400 dark:to-cyan-400">First 2 Properties</span></>
            ) : (
              <>Gratis Biaya Development untuk <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-cyan-600 dark:from-emerald-400 dark:to-cyan-400">2 Properti Pertama</span></>
            )}
          </h2>

          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
            {prog.description}
          </p>

          <!-- Benefits & Terms Highlights -->
          <div class="space-y-3 pt-2">
            {prog.conditions.map((cond) => (
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <p class="text-sm font-medium text-slate-700 dark:text-slate-200 leading-relaxed">{cond}</p>
              </div>
            ))}
          </div>

          <div class="pt-4 flex flex-wrap gap-4 items-center">
            <a
              href="#request-builder"
              class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-bold text-base shadow-xl shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all"
            >
              <span>{lang === 'en' ? 'Apply Property & Claim Pilot Slot' : 'Ajukan Properti & Klaim Slot Pilot'}</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: Slot Tracker Card (5 cols) -->
        <div class="lg:col-span-5">
          <div class="rounded-2xl bg-slate-50 dark:bg-slate-950 p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-xl space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-slate-200 dark:border-slate-800">
              <span class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 font-bold">
                {lang === 'en' ? 'Pilot Quota Status' : 'Status Kuota Terbuka'}
              </span>
              <span class="px-2.5 py-1 text-xs font-bold rounded-md bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-500/30">
                {lang === 'en' ? 'Applications Open' : 'Pendaftaran Dibuka'}
              </span>
            </div>

            <!-- Visual Slot Boxes (2 Slots) -->
            <div>
              <p class="text-xs text-slate-500 dark:text-slate-400 mb-3">
                {lang === 'en' ? (
                  <>Available <strong class="text-slate-900 dark:text-white font-bold">2 of 2 Slots</strong> for Pilot Properties:</>
                ) : (
                  <>Tersedia <strong class="text-slate-900 dark:text-white font-bold">2 dari 2 Kuota</strong> Properti Percontohan:</>
                )}
              </p>
              <div class="grid grid-cols-2 gap-3.5">
                <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-500/50 text-center space-y-1">
                  <span class="block text-xs font-black text-emerald-700 dark:text-emerald-400">SLOT 1</span>
                  <span class="inline-block px-2 py-0.5 text-[10px] bg-emerald-200/60 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 font-extrabold rounded-full">
                    {lang === 'en' ? 'AVAILABLE' : 'TERSEDIA'}
                  </span>
                  <p class="text-[10px] text-slate-500 dark:text-slate-400 pt-1">Boutique Hotel / Villa</p>
                </div>
                <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-500/50 text-center space-y-1">
                  <span class="block text-xs font-black text-emerald-700 dark:text-emerald-400">SLOT 2</span>
                  <span class="inline-block px-2 py-0.5 text-[10px] bg-emerald-200/60 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 font-extrabold rounded-full">
                    {lang === 'en' ? 'AVAILABLE' : 'TERSEDIA'}
                  </span>
                  <p class="text-[10px] text-slate-500 dark:text-slate-400 pt-1">Glamping / Resort</p>
                </div>
              </div>
            </div>

            <!-- Mutual Credibility Rationale -->
            <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800/80 text-xs text-slate-600 dark:text-slate-300 leading-relaxed shadow-sm space-y-2">
              <p class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{lang === 'en' ? 'Why Is This Scheme Free?' : 'Mengapa Skema Ini Gratis?'}</span>
              </p>
              <p>
                {lang === 'en'
                  ? 'We invest tens of millions in engineering time free of charge, in exchange for your honest feedback, an official testimonial, and case study showcase rights to elevate Veridion Studio’s credibility with future clients.'
                  : 'Kami menginvestasikan waktu dan rekayasa kode bernilai puluhan juta rupiah secara gratis, dengan timbal balik kesediaan Anda memberikan feedback jujur dan izin publikasi studi kasus untuk mendongkrak kredibilitas Veridion Studio di hadapan klien-klien berikutnya.'}
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Row: Transparent Terms & Scope -->
      <div class="mt-16 pt-12 border-t border-slate-200 dark:border-slate-800">
        <div class="text-center max-w-3xl mx-auto mb-10">
          <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            {terms.title}
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2">
            {terms.subtitle}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
          <!-- Col 1: Covered for Free -->
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
            <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold uppercase tracking-wider text-[11px]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <span>{lang === 'en' ? 'Included Free of Charge (100% Free):' : 'Yang Dikerjakan Gratis (100% Free):'}</span>
            </div>
            <ul class="space-y-2.5 text-slate-600 dark:text-slate-300">
              {terms.covered.map((item) => (
                <li class="flex items-start gap-2 leading-relaxed">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Col 2: Client Commitment (Feedback & Kredibilitas) -->
          <div class="p-6 rounded-2xl bg-gradient-to-b from-cyan-50/50 to-white dark:from-cyan-950/20 dark:to-slate-950 border border-cyan-200 dark:border-cyan-500/30 shadow-sm space-y-4">
            <div class="flex items-center gap-2 text-cyan-700 dark:text-cyan-400 font-bold uppercase tracking-wider text-[11px]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>{lang === 'en' ? 'Property Reciprocal Commitment (T&Cs):' : 'Komitmen Timbal Balik Properti (S&K):'}</span>
            </div>
            <ul class="space-y-2.5 text-slate-700 dark:text-slate-200 font-medium">
              {terms.clientCommitment.map((item) => (
                <li class="flex items-start gap-2 leading-relaxed">
                  <span class="text-cyan-600 dark:text-cyan-400 font-bold mt-0.5">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Col 3: Not Covered / Out of Scope -->
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
            <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider text-[11px]">
              <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{lang === 'en' ? 'Out of Scope / Not Covered:' : 'Di Luar Tanggungan Program:'}</span>
            </div>
            <ul class="space-y-2.5 text-slate-600 dark:text-slate-300">
              {terms.notCovered.map((item) => (
                <li class="flex items-start gap-2 leading-relaxed">
                  <span class="text-slate-400 font-bold">-</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
