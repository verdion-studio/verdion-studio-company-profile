---
import { earlyPartnerProgram, pilotTerms } from '../../data/content';
---

<section id="early-partner" class="py-20 md:py-28 relative bg-gradient-to-b from-slate-100 via-emerald-50/50 to-slate-100 dark:from-[#0B0F19] dark:via-emerald-950/20 dark:to-[#0B0F19] border-y border-emerald-500/20 dark:border-emerald-900/30 overflow-hidden transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-emerald-500/30 bg-white/90 dark:bg-slate-900/90 p-8 sm:p-12 lg:p-16 relative shadow-2xl backdrop-blur-xl">
      
      <!-- Glow Decor -->
      <div class="absolute top-0 right-1/4 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Top Row: Overview & Slots -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Left: Explanations (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100 dark:bg-emerald-500/20 border border-emerald-300 dark:border-emerald-500/40 text-emerald-800 dark:text-emerald-300 text-xs font-bold tracking-wide">
            <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-ping"></span>
            <span>PROGRAM SPESIAL PELUNCURAN</span>
          </div>

          <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white leading-tight">
            Gratis Biaya Development untuk <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-cyan-600 dark:from-emerald-400 dark:to-cyan-400">3 Klien Pertama</span>
          </h2>

          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
            Sebagai langkah awal memperkenalkan standar rekayasa software Veridion Studio, kami membuka kesempatan kemitraan percontohan. Kami akan membangun sistem/web Anda tanpa biaya pengerjaan.
          </p>

          <!-- Benefits & Terms -->
          <div class="space-y-3 pt-2">
            {earlyPartnerProgram.conditions.map((cond) => (
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <p class="text-sm text-slate-700 dark:text-slate-200">{cond}</p>
              </div>
            ))}
          </div>

          <div class="pt-4 flex flex-wrap gap-4 items-center">
            <a
              href="#request-builder"
              class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-bold text-base shadow-xl shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all"
            >
              <span>Ajukan Aplikasi & Klaim Kuota Gratis</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: Slot Tracker Card (5 cols) -->
        <div class="lg:col-span-5">
          <div class="rounded-2xl bg-slate-50 dark:bg-slate-950 p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-xl space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-slate-200 dark:border-slate-800">
              <span class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 font-semibold">Status Kuota Terbuka</span>
              <span class="px-2.5 py-1 text-xs font-bold rounded-md bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-500/30">
                Pendaftaran Dibuka
              </span>
            </div>

            <!-- Visual Slot Boxes -->
            <div>
              <p class="text-xs text-slate-500 dark:text-slate-400 mb-3">Tersedia <strong class="text-slate-900 dark:text-white">3 dari 3 Kuota</strong> Klien Pertama:</p>
              <div class="grid grid-cols-3 gap-3">
                <div class="p-3.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-500/50 text-center">
                  <span class="block text-xs font-bold text-emerald-700 dark:text-emerald-400">Slot 1</span>
                  <span class="text-[11px] text-emerald-800 dark:text-emerald-200 font-medium">TERSEDIA</span>
                </div>
                <div class="p-3.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-500/50 text-center">
                  <span class="block text-xs font-bold text-emerald-700 dark:text-emerald-400">Slot 2</span>
                  <span class="text-[11px] text-emerald-800 dark:text-emerald-200 font-medium">TERSEDIA</span>
                </div>
                <div class="p-3.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-500/50 text-center">
                  <span class="block text-xs font-bold text-emerald-700 dark:text-emerald-400">Slot 3</span>
                  <span class="text-[11px] text-emerald-800 dark:text-emerald-200 font-medium">TERSEDIA</span>
                </div>
              </div>
            </div>

            <!-- Notice Info -->
            <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800/80 text-xs text-slate-600 dark:text-slate-400 leading-relaxed shadow-sm">
              <p>
                <strong class="text-slate-800 dark:text-slate-200">Kenapa Gratis?</strong> Kami ingin membuktikan kapabilitas kami dengan hasil riil yang bisa langsung Anda pakai di bisnis Anda, sekaligus membangun relasi jangka panjang.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Row: Transparent Terms & Scope (Professional Boundaries) -->
      <div class="mt-14 pt-10 border-t border-slate-200 dark:border-slate-800">
        <div class="text-center max-w-2xl mx-auto mb-8">
          <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
            {pilotTerms.title}
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1">
            {pilotTerms.subtitle}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
          <!-- Col 1: Covered for Free -->
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold uppercase tracking-wider text-[11px]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <span>Yang Dikerjakan Gratis (100% Free):</span>
            </div>
            <ul class="space-y-2 text-slate-600 dark:text-slate-300">
              {pilotTerms.covered.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Col 2: Client Commitment -->
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center gap-2 text-cyan-600 dark:text-cyan-400 font-bold uppercase tracking-wider text-[11px]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Komitmen Timbal Balik Klien:</span>
            </div>
            <ul class="space-y-2 text-slate-600 dark:text-slate-300">
              {pilotTerms.clientCommitment.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="text-cyan-500 font-bold">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Col 3: Not Covered / Out of Scope -->
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider text-[11px]">
              <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Di Luar Tanggungan Program:</span>
            </div>
            <ul class="space-y-2 text-slate-600 dark:text-slate-300">
              {pilotTerms.notCovered.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="text-slate-400 font-bold">-</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
