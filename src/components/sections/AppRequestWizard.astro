---
---

<section id="request-builder" class="py-20 md:py-28 relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-100 dark:bg-cyan-500/10 border border-cyan-300 dark:border-cyan-500/30 text-cyan-800 dark:text-cyan-400 text-xs font-semibold mb-3">
        <span>Interactive Property Spec Builder</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Rancang Sistem Properti Sesuai Kebutuhan Villa / Hotel Anda
      </h2>
      <p class="mt-4 text-base text-slate-600 dark:text-slate-400">
        Pilih jenis properti, jumlah kamar, dan modul yang ingin dibangun. Spesifikasi sistem Anda akan terangkum rapi dan terhubung langsung ke WhatsApp & Email lead developer Veridion Studio.
      </p>
    </div>

    <!-- Interactive Card Form -->
    <div class="rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 sm:p-10 shadow-xl dark:shadow-2xl relative overflow-hidden transition-colors duration-300">
      <form id="propertyRequestForm" class="space-y-10">
        
        <!-- Step 1: Property Type -->
        <div>
          <label class="block text-sm font-bold text-slate-900 dark:text-white mb-3">
            1. Apa Jenis Properti Anda?
          </label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="propertyTypeGrid">
            <label class="cursor-pointer">
              <input type="radio" name="propertyType" value="Luxury Private Villa / Vacation Rental" class="peer sr-only" checked />
              <div class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-transparent peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-950/30 text-center hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <span class="block text-sm font-semibold text-slate-800 dark:text-white peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400">Private Villa</span>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">Luxury Rental</span>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="propertyType" value="Boutique Hotel / Heritage Stay" class="peer sr-only" />
              <div class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-transparent peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-950/30 text-center hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <span class="block text-sm font-semibold text-slate-800 dark:text-white peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400">Boutique Hotel</span>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">City / Heritage</span>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="propertyType" value="Glamping & Eco-Resort" class="peer sr-only" />
              <div class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-transparent peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-950/30 text-center hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <span class="block text-sm font-semibold text-slate-800 dark:text-white peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400">Glamping & Resort</span>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">Nature & Retreat</span>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="propertyType" value="Hotel F&B / Lounge / Beach Club" class="peer sr-only" />
              <div class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-transparent peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-950/30 text-center hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <span class="block text-sm font-semibold text-slate-800 dark:text-white peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400">Hotel F&B / Bar</span>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">Resto & Lounge</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Step 2: Room Capacity -->
        <div>
          <label class="block text-sm font-bold text-slate-900 dark:text-white mb-3">
            2. Berapa Jumlah Kamar / Unit yang Dikelola?
          </label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <label class="cursor-pointer">
              <input type="radio" name="roomCapacity" value="1 - 5 Unit (Private/Exclusive)" class="peer sr-only" checked />
              <div class="p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-transparent peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-950/30 text-center hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <span class="block text-sm font-semibold text-slate-800 dark:text-white peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400">1 - 5 Unit</span>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">Private Villa / Exclusive</span>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="roomCapacity" value="6 - 15 Kamar (Boutique Stay)" class="peer sr-only" />
              <div class="p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-transparent peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-950/30 text-center hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <span class="block text-sm font-semibold text-slate-800 dark:text-white peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400">6 - 15 Kamar</span>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">Medium Stay</span>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="roomCapacity" value="16 - 35 Kamar (Resort / Hotel)" class="peer sr-only" />
              <div class="p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-transparent peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-950/30 text-center hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <span class="block text-sm font-semibold text-slate-800 dark:text-white peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400">16 - 35 Kamar</span>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">Resort / Hotel</span>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="roomCapacity" value="35+ Kamar (Large Scale Property)" class="peer sr-only" />
              <div class="p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-transparent peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-950/30 text-center hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <span class="block text-sm font-semibold text-slate-800 dark:text-white peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400">35+ Kamar</span>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">Multi-Building</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Step 3: Core Module Selection -->
        <div>
          <label class="block text-sm font-bold text-slate-900 dark:text-white mb-3">
            3. Apa Fokus Solusi Software Utama yang Diinginkan?
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <label class="cursor-pointer">
              <input type="radio" name="solutionType" value="Direct Booking Engine + Payment Gateway" class="peer sr-only" checked />
              <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-transparent peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-950/30 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <p class="text-sm font-bold text-slate-800 dark:text-white peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400">Direct Booking Engine</p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Web direct booking, kalender ketersediaan, bayar DP/Lunas via QRIS/Kartu Kredit tanpa komisi OTA.</p>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="solutionType" value="Cloud PMS Front Desk & Housekeeping" class="peer sr-only" />
              <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-transparent peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-950/30 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <p class="text-sm font-bold text-slate-800 dark:text-white peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400">Cloud PMS Front Desk</p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Room grid check-in/out, status housekeeping real-time, folio tagihan, dan laporan night audit.</p>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="solutionType" value="All-in-One Full Property Suite (Booking + PMS + Concierge)" class="peer sr-only" />
              <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-transparent peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-950/30 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <p class="text-sm font-bold text-slate-800 dark:text-white peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400">All-in-One Property Suite</p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Paket lengkap end-to-end: Direct Booking Web + Front Desk PMS + WhatsApp Concierge + F&B Folio.</p>
              </div>
            </label>
          </div>
        </div>

        <!-- Step 4: Specific Features -->
        <div>
          <label class="block text-sm font-bold text-slate-900 dark:text-white mb-1">
            4. Pilih Modul Spesifik yang Dibutuhkan (Bisa lebih dari 1):
          </label>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-3">Centang fitur yang paling penting untuk operasional properti Anda.</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/60 hover:bg-slate-100 dark:hover:bg-slate-800/60 cursor-pointer">
              <input type="checkbox" name="features" value="iCal 2-Way Sync (Airbnb & Booking.com)" class="w-4 h-4 rounded text-emerald-500 focus:ring-0 bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700" checked />
              <span class="text-xs font-medium text-slate-700 dark:text-slate-200">iCal Sync (Anti-Overbooking)</span>
            </label>
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/60 hover:bg-slate-100 dark:hover:bg-slate-800/60 cursor-pointer">
              <input type="checkbox" name="features" value="Automated WhatsApp Guest Concierge" class="w-4 h-4 rounded text-emerald-500 focus:ring-0 bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700" checked />
              <span class="text-xs font-medium text-slate-700 dark:text-slate-200">WhatsApp Concierge Otomatis</span>
            </label>
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/60 hover:bg-slate-100 dark:hover:bg-slate-800/60 cursor-pointer">
              <input type="checkbox" name="features" value="Direct Payment Gateway (QRIS & Kartu Kredit)" class="w-4 h-4 rounded text-emerald-500 focus:ring-0 bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700" checked />
              <span class="text-xs font-medium text-slate-700 dark:text-slate-200">Direct Payment Gateway</span>
            </label>
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/60 hover:bg-slate-100 dark:hover:bg-slate-800/60 cursor-pointer">
              <input type="checkbox" name="features" value="In-Room Dining QR & Folio Billing" class="w-4 h-4 rounded text-emerald-500 focus:ring-0 bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700" checked />
              <span class="text-xs font-medium text-slate-700 dark:text-slate-200">QR Room Dining & Folio Billing</span>
            </label>
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/60 hover:bg-slate-100 dark:hover:bg-slate-800/60 cursor-pointer">
              <input type="checkbox" name="features" value="Housekeeping Mobile Room Tracker" class="w-4 h-4 rounded text-emerald-500 focus:ring-0 bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700" checked />
              <span class="text-xs font-medium text-slate-700 dark:text-slate-200">Housekeeping Mobile Tracker</span>
            </label>
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/60 hover:bg-slate-100 dark:hover:bg-slate-800/60 cursor-pointer">
              <input type="checkbox" name="features" value="Night Audit & Rekapitulasi Pajak PB1 Hotel" class="w-4 h-4 rounded text-emerald-500 focus:ring-0 bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700" />
              <span class="text-xs font-medium text-slate-700 dark:text-slate-200">Night Audit & Laporan PB1 (10%)</span>
            </label>
          </div>
        </div>

        <!-- Step 5: Property Details & PIC -->
        <div class="pt-2 border-t border-slate-200 dark:border-slate-800">
          <label class="block text-sm font-bold text-slate-900 dark:text-white mb-4">
            5. Informasi Properti & Kontak Penanggung Jawab:
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="propertyName" class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Nama Properti / Villa / Hotel *</label>
              <input
                type="text"
                id="propertyName"
                name="propertyName"
                required
                placeholder="Contoh: The Seminyak Haven Villas"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-emerald-500"
              />
            </div>
            <div>
              <label for="picName" class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Nama Owner / General Manager (GM) *</label>
              <input
                type="text"
                id="picName"
                name="picName"
                required
                placeholder="Nama Anda"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-emerald-500"
              />
            </div>
            <div>
              <label for="propertyLocation" class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Lokasi Properti</label>
              <input
                type="text"
                id="propertyLocation"
                name="propertyLocation"
                placeholder="Contoh: Badung, Bali / Yogyakarta / Bandung"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-emerald-500"
              />
            </div>
            <div>
              <label for="currentOtaPlatform" class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Kanal Penjualan Saat Ini</label>
              <input
                type="text"
                id="currentOtaPlatform"
                name="currentOtaPlatform"
                placeholder="Contoh: Airbnb, Booking.com, Traveloka, Agoda"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-emerald-500"
              />
            </div>
          </div>

          <div class="mt-4">
            <label for="additionalNotes" class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Catatan Tambahan / Kebutuhan Khusus</label>
            <textarea
              id="additionalNotes"
              name="additionalNotes"
              rows="2"
              placeholder="Ceritakan kendala operasional, target peluncuran web direct booking, atau kebutuhan integrasi khusus..."
              class="w-full px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-emerald-500"
            ></textarea>
          </div>

          <!-- Early Pilot Checkbox -->
          <div class="mt-4 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-500/40">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" id="applyPilot" name="applyPilot" class="w-4 h-4 rounded text-emerald-600 focus:ring-0 mt-0.5" checked />
              <div>
                <span class="text-xs font-bold text-emerald-800 dark:text-emerald-300 block">
                  Ajukan 1 dari 2 Slot Gratis Development (Hospitality Pilot Program — S&K Berlaku)
                </span>
                <span class="text-[11px] text-emerald-700 dark:text-emerald-400">
                  Bebas biaya pengerjaan 100% dengan timbal balik ulasan testimoni resmi dan publikasi studi kasus.
                </span>
              </div>
            </label>
          </div>
        </div>

        <!-- Submit Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-center gap-4">
          <button
            type="button"
            id="btnSubmitWA"
            class="w-full sm:w-auto flex-1 inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-bold text-sm shadow-xl shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.966 1.201.664.591 1.224.774 1.397.86.173.086.274.072.375-.044.101-.116.433-.505.549-.679.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z" />
            </svg>
            <span>Kirim Spesifikasi Properti via WhatsApp</span>
          </button>

          <button
            type="button"
            id="btnSubmitEmail"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 hover:border-emerald-500/50 text-slate-800 dark:text-white font-semibold text-sm hover:bg-slate-50 dark:hover:bg-slate-800 transition-all cursor-pointer"
          >
            <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>Kirim via Email Resmi</span>
          </button>
        </div>

      </form>
    </div>
  </div>
</section>

<script is:inline>
  function setupPropertyFormHandler() {
    const form = document.getElementById('propertyRequestForm');
    const btnWA = document.getElementById('btnSubmitWA');
    const btnEmail = document.getElementById('btnSubmitEmail');

    if (!form) return;

    function getFormData() {
      const propertyType = form.querySelector('input[name="propertyType"]:checked')?.value || 'Private Villa';
      const roomCapacity = form.querySelector('input[name="roomCapacity"]:checked')?.value || '1 - 5 Unit';
      const solutionType = form.querySelector('input[name="solutionType"]:checked')?.value || 'Direct Booking Engine';
      
      const featuresChecked = form.querySelectorAll('input[name="features"]:checked');
      const features = Array.from(featuresChecked).map(cb => cb.value);

      const propertyName = document.getElementById('propertyName')?.value.trim() || '';
      const picName = document.getElementById('picName')?.value.trim() || '';
      const propertyLocation = document.getElementById('propertyLocation')?.value.trim() || 'Indonesia';
      const currentOtaPlatform = document.getElementById('currentOtaPlatform')?.value.trim() || 'OTA Umum';
      const additionalNotes = document.getElementById('additionalNotes')?.value.trim() || 'Tidak ada catatan tambahan';
      const applyPilot = document.getElementById('applyPilot')?.checked || false;

      return {
        propertyType,
        roomCapacity,
        solutionType,
        features,
        propertyName,
        picName,
        propertyLocation,
        currentOtaPlatform,
        additionalNotes,
        applyPilot
      };
    }

    if (btnWA) {
      btnWA.addEventListener('click', () => {
        const data = getFormData();
        if (!data.propertyName || !data.picName) {
          alert('Mohon isi Nama Properti dan Nama Owner / GM terlebih dahulu.');
          return;
        }

        const featureList = data.features.length > 0 
          ? data.features.map((f, i) => `  ${i+1}. ${f}`).join('\n')
          : '  - Mengikuti rekomendasi tim Veridion';

        const pilotStatus = data.applyPilot 
          ? 'YA (Mengajukan Slot Gratis 2 Properti Pertama - S&K Berlaku)' 
          : 'TIDAK';

        const message = 
`Halo Tim Veridion Studio, saya ingin berkonsultasi mengenai pembuatan sistem properti berikut:

🏨 DETAIL PROPERTI:
• Nama Properti: ${data.propertyName}
• Owner / GM: ${data.picName}
• Lokasi: ${data.propertyLocation}
• Kanal Saat Ini: ${data.currentOtaPlatform}
• Program Pilot Gratis: ${pilotStatus}

⚙️ PREFERENSI SISTEM:
• Tipe Properti: ${data.propertyType}
• Kapasitas Unit: ${data.roomCapacity}
• Fokus Solusi: ${data.solutionType}

✨ MODUL YANG DIBUTUHKAN:
${featureList}

📝 Catatan Tambahan:
${data.additionalNotes}

