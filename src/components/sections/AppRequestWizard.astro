---
---

<section id="request-builder" class="py-20 md:py-28 relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-semibold mb-3">
        <span>Interactive App Request</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Rancang Aplikasi Sesuai Preferensi Bisnis Anda
      </h2>
      <p class="mt-4 text-base text-slate-400">
        Pilih industri, platform, dan fitur yang Anda butuhkan. Sistem kami akan merangkum spesifikasi proyek Anda dan menghubungkannya langsung ke WhatsApp / Email tim Veridion Studio.
      </p>
    </div>

    <!-- Interactive Card Form -->
    <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 sm:p-10 shadow-2xl relative overflow-hidden">
      <form id="appRequestForm" class="space-y-10">
        
        <!-- Step 1: Industry -->
        <div>
          <label class="block text-sm font-bold text-white mb-3">
            1. Apa Bidang Usaha / Industri Bisnis Anda?
          </label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="industryGrid">
            <label class="cursor-pointer">
              <input type="radio" name="industry" value="Cafe / Resto / F&B" class="peer sr-only" checked />
              <div class="p-3.5 rounded-xl border border-slate-700 peer-checked:border-emerald-400 peer-checked:bg-emerald-950/30 text-center hover:bg-slate-800 transition-all">
                <span class="block text-sm font-semibold text-white peer-checked:text-emerald-400">Cafe & Resto</span>
                <span class="text-[11px] text-slate-400">F&B & Kuliner</span>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="industry" value="Apotik / Klinik Kesehatan" class="peer sr-only" />
              <div class="p-3.5 rounded-xl border border-slate-700 peer-checked:border-emerald-400 peer-checked:bg-emerald-950/30 text-center hover:bg-slate-800 transition-all">
                <span class="block text-sm font-semibold text-white peer-checked:text-emerald-400">Apotek & Klinik</span>
                <span class="text-[11px] text-slate-400">Farmasi & Medis</span>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="industry" value="Perhotelan / Villa / Penginapan" class="peer sr-only" />
              <div class="p-3.5 rounded-xl border border-slate-700 peer-checked:border-emerald-400 peer-checked:bg-emerald-950/30 text-center hover:bg-slate-800 transition-all">
                <span class="block text-sm font-semibold text-white peer-checked:text-emerald-400">Perhotelan</span>
                <span class="text-[11px] text-slate-400">Villa & Homestay</span>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="industry" value="Retail / Toko / UMKM Lainnya" class="peer sr-only" />
              <div class="p-3.5 rounded-xl border border-slate-700 peer-checked:border-emerald-400 peer-checked:bg-emerald-950/30 text-center hover:bg-slate-800 transition-all">
                <span class="block text-sm font-semibold text-white peer-checked:text-emerald-400">Retail & UMKM</span>
                <span class="text-[11px] text-slate-400">Toko & Jasa Lainnya</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Step 2: Solution Type -->
        <div>
          <label class="block text-sm font-bold text-white mb-3">
            2. Apa Jenis Solusi Software Utama yang Diinginkan?
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <label class="cursor-pointer">
              <input type="radio" name="solutionType" value="Sistem Kasir (POS) + Inventaris" class="peer sr-only" checked />
              <div class="p-4 rounded-xl border border-slate-700 peer-checked:border-emerald-400 peer-checked:bg-emerald-950/30 hover:bg-slate-800 transition-all">
                <p class="text-sm font-bold text-white peer-checked:text-emerald-400">Sistem Kasir (POS)</p>
                <p class="text-xs text-slate-400 mt-1">Pencatatan transaksi kasir, struk belanja, dan rekap stok harian.</p>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="solutionType" value="Company Profile / Website Resmi" class="peer sr-only" />
              <div class="p-4 rounded-xl border border-slate-700 peer-checked:border-emerald-400 peer-checked:bg-emerald-950/30 hover:bg-slate-800 transition-all">
                <p class="text-sm font-bold text-white peer-checked:text-emerald-400">Website Company Profile</p>
                <p class="text-xs text-slate-400 mt-1">Branding resmi, katalog produk/layanan, portofolio & SEO Google.</p>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="solutionType" value="Sistem Operasional / Booking Khusus" class="peer sr-only" />
              <div class="p-4 rounded-xl border border-slate-700 peer-checked:border-emerald-400 peer-checked:bg-emerald-950/30 hover:bg-slate-800 transition-all">
                <p class="text-sm font-bold text-white peer-checked:text-emerald-400">Sistem Manajemen / Booking</p>
                <p class="text-xs text-slate-400 mt-1">Jadwal reservasi kamar/meja, invoicing, dan laporan admin khusus.</p>
              </div>
            </label>
          </div>
        </div>

        <!-- Step 3: Specific Features -->
        <div>
          <label class="block text-sm font-bold text-white mb-1">
            3. Pilih Fitur Tambahan yang Dibutuhkan (Bisa lebih dari 1):
          </label>
          <p class="text-xs text-slate-400 mb-3">Centang fitur yang paling penting untuk operasional Anda.</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-800 bg-slate-950/60 hover:bg-slate-800/60 cursor-pointer">
              <input type="checkbox" name="features" value="Pencatatan Stok & Expired Date" class="w-4 h-4 rounded text-emerald-500 focus:ring-0 bg-slate-900 border-slate-700" checked />
              <span class="text-xs font-medium text-slate-200">Manajemen Stok & Expired</span>
            </label>
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-800 bg-slate-950/60 hover:bg-slate-800/60 cursor-pointer">
              <input type="checkbox" name="features" value="Laporan Penjualan Excel/PDF" class="w-4 h-4 rounded text-emerald-500 focus:ring-0 bg-slate-900 border-slate-700" checked />
              <span class="text-xs font-medium text-slate-200">Ekspor Laporan Omzet PDF/Excel</span>
            </label>
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-800 bg-slate-950/60 hover:bg-slate-800/60 cursor-pointer">
              <input type="checkbox" name="features" value="Cetak Struk Thermal / Bluetooth" class="w-4 h-4 rounded text-emerald-500 focus:ring-0 bg-slate-900 border-slate-700" checked />
              <span class="text-xs font-medium text-slate-200">Cetak Struk Kasir Bluetooth</span>
            </label>
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-800 bg-slate-950/60 hover:bg-slate-800/60 cursor-pointer">
              <input type="checkbox" name="features" value="Integrasi Pesanan WhatsApp" class="w-4 h-4 rounded text-emerald-500 focus:ring-0 bg-slate-900 border-slate-700" />
              <span class="text-xs font-medium text-slate-200">Integrasi WhatsApp Order</span>
            </label>
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-800 bg-slate-950/60 hover:bg-slate-800/60 cursor-pointer">
              <input type="checkbox" name="features" value="Multi-User / Hak Akses Kasir & Owner" class="w-4 h-4 rounded text-emerald-500 focus:ring-0 bg-slate-900 border-slate-700" />
              <span class="text-xs font-medium text-slate-200">Multi-Role (Owner & Kasir)</span>
            </label>
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-800 bg-slate-950/60 hover:bg-slate-800/60 cursor-pointer">
              <input type="checkbox" name="features" value="Katalog / Menu Digital QR" class="w-4 h-4 rounded text-emerald-500 focus:ring-0 bg-slate-900 border-slate-700" />
              <span class="text-xs font-medium text-slate-200">Menu / Katalog QR Code</span>
            </label>
          </div>
        </div>

        <!-- Step 4: Contact & Early Partner Checkbox -->
        <div class="pt-4 border-t border-slate-800 space-y-4">
          <label class="block text-sm font-bold text-white mb-2">
            4. Detail Bisnis & Kontak Anda:
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs text-slate-400 mb-1">Nama Bisnis / Usaha Anda *</label>
              <input
                type="text"
                id="businessName"
                required
                placeholder="Contoh: Kopi Nusantara / Apotek Sehat"
                class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:outline-none focus:border-emerald-400"
              />
            </div>
            <div>
              <label class="block text-xs text-slate-400 mb-1">Nama Pemilik / PIC *</label>
              <input
                type="text"
                id="ownerName"
                required
                placeholder="Contoh: Budi Santoso"
                class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:outline-none focus:border-emerald-400"
              />
            </div>
            <div>
              <label class="block text-xs text-slate-400 mb-1">Kota / Lokasi Bisnis</label>
              <input
                type="text"
                id="businessLocation"
                placeholder="Contoh: Surabaya, Jakarta, Medan"
                class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:outline-none focus:border-emerald-400"
              />
            </div>
            <div>
              <label class="block text-xs text-slate-400 mb-1">Catatan Tambahan (Opsional)</label>
              <input
                type="text"
                id="additionalNotes"
                placeholder="Ada kebutuhan spesifik lainnya?"
                class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:outline-none focus:border-emerald-400"
              />
            </div>
          </div>

          <!-- Early Partner Opt-in -->
          <div class="p-4 rounded-xl bg-emerald-950/40 border border-emerald-500/40 mt-4">
            <label class="flex items-start gap-3 cursor-pointer">
              <input
                type="checkbox"
                id="applyEarlyPartner"
                checked
                class="w-5 h-5 rounded text-emerald-500 focus:ring-0 bg-slate-900 border-slate-600 mt-0.5"
              />
              <div>
                <span class="text-sm font-bold text-emerald-300">
                  Daftarkan saya untuk Program 3 Klien Pertama (Gratis Development Fee)
                </span>
                <p class="text-xs text-slate-300 mt-0.5">
                  Saya bersedia memberikan ulasan/feedback dan menjadi studi kasus resmi Veridion Studio.
                </p>
              </div>
            </label>
          </div>
        </div>

        <!-- Action Submit Buttons -->
        <div class="flex flex-col sm:flex-row items-center gap-4 pt-4">
          <button
            type="button"
            id="btnSendWhatsApp"
            class="w-full sm:w-auto flex-1 inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-bold text-base shadow-xl shadow-emerald-500/20 hover:shadow-emerald-500/40 hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.771.78 2.796.78 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.587-5.766-5.768-5.766zm9.969 5.766c0 5.514-4.486 10-10 10-1.802 0-3.489-.481-4.945-1.319l-7.055 1.849 1.879-6.868c-.911-1.503-1.44-3.264-1.44-5.143 0-5.514 4.486-10 10-10s10 4.486 10 10z"/>
            </svg>
            <span>Kirim Pengajuan via WhatsApp</span>
          </button>

          <button
            type="button"
            id="btnSendEmail"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm transition-all border border-slate-700 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>Kirim via Email</span>
          </button>
        </div>

        <p class="text-center text-xs text-slate-500">
          * Ringkasan spesifikasi aplikasi akan otomatis tersusun rapi. Tim teknis Veridion Studio akan langsung membalas dalam kurun waktu 1x24 jam.
        </p>

      </form>
    </div>
  </div>
</section>

<script>
  function setupFormHandler() {
    const btnWA = document.getElementById('btnSendWhatsApp');
    const btnEmail = document.getElementById('btnSendEmail');

    function getFormData() {
      const form = document.getElementById('appRequestForm') as HTMLFormElement;
      const industry = (form.querySelector('input[name="industry"]:checked') as HTMLInputElement)?.value || 'Belum dipilih';
      const solutionType = (form.querySelector('input[name="solutionType"]:checked') as HTMLInputElement)?.value || 'Belum dipilih';
      
      const featuresChecked = Array.from(form.querySelectorAll('input[name="features"]:checked'))
        .map((el) => (el as HTMLInputElement).value);
      
      const businessName = (document.getElementById('businessName') as HTMLInputElement)?.value || '';
      const ownerName = (document.getElementById('ownerName') as HTMLInputElement)?.value || '';
      const businessLocation = (document.getElementById('businessLocation') as HTMLInputElement)?.value || 'Indonesia';
      const additionalNotes = (document.getElementById('additionalNotes') as HTMLInputElement)?.value || '-';
      const applyEarly = (document.getElementById('applyEarlyPartner') as HTMLInputElement)?.checked;

      return {
        industry,
        solutionType,
        features: featuresChecked,
        businessName,
        ownerName,
        businessLocation,
        additionalNotes,
        applyEarly
      };
    }

    if (btnWA) {
      btnWA.addEventListener('click', () => {
        const data = getFormData();
        if (!data.businessName || !data.ownerName) {
          alert('Mohon isi Nama Bisnis dan Nama Pemilik/PIC terlebih dahulu.');
          return;
        }

        const featureList = data.features.length > 0 
          ? data.features.map((f, i) => `  ${i+1}. ${f}`).join('\n')
          : '  - Mengikuti rekomendasi tim Veridion';

        const promoStatus = data.applyEarly 
          ? 'YA (Mengajukan Slot Gratis 3 Klien Pertama)' 
          : 'TIDAK';

        const message = 
`Halo Tim Veridion Studio, saya ingin mengajukan pembuatan aplikasi sesuai preferensi berikut:

📋 DETAIL BISNIS:
• Nama Bisnis: ${data.businessName}
• Pemilik / PIC: ${data.ownerName}
• Lokasi: ${data.businessLocation}
• Program Early Partner (Gratis Dev): ${promoStatus}

⚙️ PREFERENSI SISTEM:
• Industri: ${data.industry}
• Solusi Utama: ${data.solutionType}

✨ FITUR YANG DIBUTUHKAN:
${featureList}

📝 Catatan Tambahan:
${data.additionalNotes}

Mohon informasi langkah selanjutnya dan estimasi jadwal pengerjaannya. Terima kasih!`;

        // Encode message for WhatsApp
        const waNumber = '6281234567890'; // Developer can update WhatsApp number
        const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`;
        window.open(waUrl, '_blank');
      });
    }

    if (btnEmail) {
      btnEmail.addEventListener('click', () => {
        const data = getFormData();
        if (!data.businessName || !data.ownerName) {
          alert('Mohon isi Nama Bisnis dan Nama Pemilik/PIC terlebih dahulu.');
          return;
        }

        const subject = encodeURIComponent(`[Pengajuan Aplikasi] ${data.businessName} - ${data.solutionType}`);
        const body = encodeURIComponent(
          `Halo Tim Veridion Studio,\n\nNama Bisnis: ${data.businessName}\nPemilik/PIC: ${data.ownerName}\nLokasi: ${data.businessLocation}\n\nIndustri: ${data.industry}\nSolusi: ${data.solutionType}\nFitur: ${data.features.join(', ')}\nEarly Partner: ${data.applyEarly ? 'Ya' : 'Tidak'}\nCatatan: ${data.additionalNotes}`
        );
        window.location.href = `mailto:contact@veridionstudio.com?subject=${subject}&body=${body}`;
      });
    }
  }

  setupFormHandler();
</script>

