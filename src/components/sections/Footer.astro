---
import { ui, type Language } from '../../i18n/ui';

interface Props {
  lang?: Language;
}

const { lang = 'id' } = Astro.props;
const t = ui[lang].footer;
const nav = ui[lang].nav;
---

<footer class="bg-slate-100 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-900 py-16 relative transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Brand & Bio -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-500 to-cyan-500 p-0.5">
            <div class="w-full h-full bg-white dark:bg-[#070A12] rounded-[10px] flex items-center justify-center font-bold text-emerald-500 dark:text-emerald-400 text-sm">
              V
            </div>
          </div>
          <span class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">
            Veridion <span class="text-emerald-600 dark:text-emerald-400">Studio</span>
          </span>
        </div>
        <p class="text-slate-600 dark:text-slate-400 text-sm max-w-md leading-relaxed">
          {t.bio}
        </p>
        <p class="text-xs text-emerald-700 dark:text-emerald-400/80 font-medium">
          {t.revenueTrust}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <p class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-4">{t.navTitle}</p>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li><a href="#solusi" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{nav.solusi}</a></li>
          <li><a href="#portofolio" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{nav.portofolio}</a></li>
          <li><a href="#kalkulator-roi" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{nav.kalkulator}</a></li>
          <li><a href="#arsitektur-teknologi" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{nav.standar}</a></li>
          <li><a href="#early-partner" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{nav.pilot} ({nav.pilotBadge})</a></li>
          <li><a href="#request-builder" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{nav.rancang}</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <p class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-4">{t.contactTitle}</p>
        <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-400">
          <li class="flex items-center gap-2">
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold">WA:</span>
            <a href="https://wa.me/6282322370126" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              {t.contactWA}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-cyan-600 dark:text-cyan-400 font-semibold">Email:</span>
            <a href="mailto:verdionstudio@gmail.com" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              verdionstudio@gmail.com
            </a>
          </li>
          <li class="text-xs text-slate-500 pt-2">
            {t.operatingHours}
          </li>
        </ul>
      </div>

    </div>

    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-900 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>&copy; {new Date().getFullYear()} Veridion Studio. Dedicated Hospitality Tech Studio.</p>
      <p class="text-slate-600 dark:text-slate-400">{t.mission}</p>
    </div>
  </div>
</footer>
