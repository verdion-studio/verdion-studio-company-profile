---
import { industrySolutions } from '../../data/content';
---

<section id="solusi" class="py-20 md:py-28 relative bg-slate-950/50 border-y border-slate-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-emerald-400 font-bold mb-3">Solusi Siap Pakai & Kustom</h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Didesain Khusus untuk Karakteristik Bisnis Anda
      </p>
      <p class="mt-4 text-base text-slate-400">
        Kami memahami setiap bidang usaha memiliki alur kerja yang berbeda. Pilih industri Anda untuk melihat modul sistem yang paling optimal.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {industrySolutions.map((item) => (
        <div class="group relative rounded-2xl bg-slate-900/80 border border-slate-800 p-6 hover:border-emerald-500/50 hover:bg-slate-900 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-emerald-950 border border-emerald-500/30 text-emerald-400">
                {item.badge}
              </span>
            </div>
            
            <h3 class="text-xl font-bold text-white group-hover:text-emerald-400 transition-colors">
              {item.name}
            </h3>
            
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">
              {item.description}
            </p>

            <div class="mt-6 pt-5 border-t border-slate-800/80">
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Modul Rekomendasi:</p>
              <ul class="space-y-2">
                {item.recommendedFeatures.map((feat) => (
                  <li class="flex items-center gap-2 text-xs text-slate-300">
                    <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-8 pt-4">
            <a
              href="#request-builder"
              class="inline-flex items-center gap-2 text-xs font-bold text-emerald-400 hover:text-emerald-300 transition-colors"
            >
              <span>Ajukan Sistem untuk Industri Ini</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

