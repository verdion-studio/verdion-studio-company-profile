---
import { earlyPartnerProgram } from '../../data/content';
---

<section class="relative pt-24 pb-20 md:pt-36 md:pb-32 overflow-hidden">
  <!-- Aesthetic Background Ambient Orbs -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-gradient-to-b from-emerald-500/15 via-teal-500/10 to-transparent blur-3xl pointer-events-none rounded-full"></div>
  <div class="absolute top-1/2 -right-40 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
      
      <!-- Top Luxury Network & Live Demo Pill Badge -->
      <div class="inline-flex flex-wrap items-center justify-center gap-2 px-4 py-2 rounded-full bg-white/80 dark:bg-slate-900/80 border border-emerald-500/30 text-xs md:text-sm font-semibold mb-8 backdrop-blur-md shadow-lg shadow-emerald-500/5">
        <span class="flex h-2.5 w-2.5 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="text-slate-700 dark:text-slate-300">
          BALI & NUSANTARA PROPERTY NETWORK • 
          <strong class="text-emerald-600 dark:text-emerald-400">3 Slot Pilot Gratis Tersedia</strong>
        </span>
        <a
          href="https://cute-liger-eb138a.netlify.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[11px] font-bold text-cyan-600 dark:text-cyan-400 hover:underline ml-1"
        >
          <span>Lihat Live Demo</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.12]">
        Arsitektur Digital & Direct Booking untuk <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 via-teal-500 to-cyan-600 dark:from-emerald-400 dark:via-teal-300 dark:to-cyan-400">Luxury Villa & Boutique Hotel</span>.
      </h1>

      <!-- Subheadline -->
      <p class="mt-7 text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
        Selamatkan <strong>15–20% profit yang terbuang ke komisi OTA</strong>. Kami merekayasa Direct Booking Engine mandiri, 2-Way iCal Calendar Sync, Cloud PMS Front Desk, serta WhatsApp Guest Concierge — diskusi teknis langsung dengan tech lead tanpa perantara.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
        <a
          href="https://cute-liger-eb138a.netlify.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-500 via-teal-500 to-cyan-500 text-slate-950 font-extrabold text-base shadow-xl shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 group"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Uji Live Demo: Aura Haven Villa Direct</span>
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a
          href="#kalkulator-roi"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-800 hover:border-emerald-500/50 text-slate-800 dark:text-white font-bold text-base hover:bg-slate-50 dark:hover:bg-slate-800/80 shadow-sm transition-all duration-200"
        >
          <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          <span>Hitung Penghematan OTA</span>
        </a>
      </div>

      <!-- Quick Trust Indicators (Luxury Glassmorphic Grid) -->
      <div class="mt-16 pt-12 border-t border-slate-200 dark:border-slate-800/80 w-full grid grid-cols-2 lg:grid-cols-4 gap-5 text-left">
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800/80 shadow-sm hover:border-emerald-500/30 transition-colors">
          <p class="text-3xl font-black text-emerald-600 dark:text-emerald-400">0% Komisi</p>
          <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 font-medium leading-relaxed">Uang tamu 100% langsung masuk ke rekening bank pemilik properti</p>
        </div>
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800/80 shadow-sm hover:border-cyan-500/30 transition-colors">
          <p class="text-3xl font-black text-cyan-600 dark:text-cyan-400">Sync 2-Arah</p>
          <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 font-medium leading-relaxed">Cegah overbooking otomatis antara direct web & Airbnb/Booking.com</p>
        </div>
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800/80 shadow-sm hover:border-teal-500/30 transition-colors">
          <p class="text-3xl font-black text-teal-600 dark:text-teal-400">Auto Concierge</p>
          <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 font-medium leading-relaxed">Kirim instruksi check-in, maps & WiFi via WhatsApp otomatis</p>
        </div>
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800/80 shadow-sm hover:border-slate-500/30 transition-colors">
          <p class="text-3xl font-black text-slate-900 dark:text-white">Cloud PMS</p>
          <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 font-medium leading-relaxed">Room status & housekeeping mobile-ready tanpa beli hardware mahal</p>
        </div>
      </div>

    </div>
  </div>
</section>
