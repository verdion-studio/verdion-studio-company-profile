---
import { earlyPartnerProgram } from '../../data/content';
---

<section class="relative pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
      
      <!-- Trust / Urgency Badge -->
      <a
        href="#early-partner"
        class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-emerald-950/60 border border-emerald-500/30 text-emerald-300 text-xs md:text-sm font-semibold mb-8 hover:bg-emerald-900/50 transition-colors shadow-lg shadow-emerald-950/50"
      >
        <span class="flex h-2.5 w-2.5 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span>{earlyPartnerProgram.badgeText} : <strong>Gratis Development untuk 3 Klien Pertama</strong></span>
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.15]">
        Software House Solutif untuk Bisnis Berkembang & <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">UMKM Modern</span>.
      </h1>

      <!-- Subheadline -->
      <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl leading-relaxed">
        Kami membangun sistem POS kasir, manajemen stok apotek, sistem reservasi, hingga web portal profesional yang <strong>langsung berdampak pada operasional dan omzet bisnis Anda</strong>.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
        <a
          href="#request-builder"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-500 via-teal-500 to-cyan-500 text-slate-950 font-bold text-base shadow-xl shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          <span>Rancang Aplikasi Sesuai Preferensi</span>
        </a>

        <a
          href="#early-partner"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-slate-900 border border-slate-700/80 hover:border-emerald-500/50 text-white font-semibold text-base hover:bg-slate-800 transition-all duration-200"
        >
          <span>Klaim 1 dari 3 Slot Gratis</span>
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        </a>
      </div>

      <!-- Quick Trust Indicators -->
      <div class="mt-14 pt-10 border-t border-slate-800/80 w-full grid grid-cols-2 md:grid-cols-4 gap-6 text-left">
        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60">
          <p class="text-2xl font-extrabold text-emerald-400">100% Nyata</p>
          <p class="text-xs text-slate-400 mt-1">Sistem diuji & aktif digunakan operasional lapangan</p>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60">
          <p class="text-2xl font-extrabold text-cyan-400">Zero Complicated</p>
          <p class="text-xs text-slate-400 mt-1">Antarmuka ramah staf kasir & pemilik bisnis</p>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60">
          <p class="text-2xl font-extrabold text-teal-400">Aman & Teruji</p>
          <p class="text-xs text-slate-400 mt-1">Studi kasus aktif pada CV Pelangi Efrata</p>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60">
          <p class="text-2xl font-extrabold text-white">Full Support</p>
          <p class="text-xs text-slate-400 mt-1">Pendampingan langsung hingga sistem siap pakai</p>
        </div>
      </div>

    </div>
  </div>
</section>

