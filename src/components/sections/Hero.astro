---
import { earlyPartnerProgram } from '../../data/content';
---

<section class="relative pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
      
      <!-- Trust / Urgency Badge -->
      <a
        href="#early-partner"
        class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-emerald-100 dark:bg-emerald-950/60 border border-emerald-300 dark:border-emerald-500/30 text-emerald-800 dark:text-emerald-300 text-xs md:text-sm font-semibold mb-8 hover:bg-emerald-200 dark:hover:bg-emerald-900/50 transition-colors shadow-lg shadow-emerald-500/5 dark:shadow-emerald-950/50"
      >
        <span class="flex h-2.5 w-2.5 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-600 dark:bg-emerald-500"></span>
        </span>
        <span>{earlyPartnerProgram.badgeText} : <strong>Gratis Development untuk 3 Properti Pertama</strong></span>
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
        Hospitality Tech Studio untuk <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 via-teal-500 to-cyan-600 dark:from-emerald-400 dark:via-teal-300 dark:to-cyan-400">Boutique Hotel & Luxury Villa</span>.
      </h1>

      <!-- Subheadline -->
      <p class="mt-6 text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
        Hentikan pemborosan <strong>komisi 15–20% ke OTA</strong>. Kami merekayasa Direct Booking Engine mandiri, Cloud PMS Front Desk, serta WhatsApp Guest Concierge — diskusi teknis langsung dengan developer tanpa perantara.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
        <a
          href="#kalkulator-roi"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-500 via-teal-500 to-cyan-500 text-slate-950 font-bold text-base shadow-xl shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          <span>Hitung Penghematan Komisi (Kalkulator ROI)</span>
        </a>

        <a
          href="#request-builder"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700/80 hover:border-emerald-500/50 text-slate-800 dark:text-white font-semibold text-base hover:bg-slate-50 dark:hover:bg-slate-800 shadow-sm transition-all duration-200"
        >
          <span>Rancang Sistem Properti Anda</span>
          <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
        </a>
      </div>

      <!-- Quick Trust Indicators -->
      <div class="mt-14 pt-10 border-t border-slate-200 dark:border-slate-800/80 w-full grid grid-cols-2 md:grid-cols-4 gap-6 text-left">
        <div class="p-4 rounded-xl bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/60 shadow-sm">
          <p class="text-2xl font-extrabold text-emerald-600 dark:text-emerald-400">0% Komisi OTA</p>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Uang pembayaran tamu 100% langsung ke rekening Anda</p>
        </div>
        <div class="p-4 rounded-xl bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/60 shadow-sm">
          <p class="text-2xl font-extrabold text-cyan-600 dark:text-cyan-400">Sync iCal 2-Arah</p>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Cegah overbooking otomatis dengan Airbnb & Booking.com</p>
        </div>
        <div class="p-4 rounded-xl bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/60 shadow-sm">
          <p class="text-2xl font-extrabold text-teal-600 dark:text-teal-400">Auto Concierge</p>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Kirim instruksi check-in, maps & WiFi via WhatsApp tamu</p>
        </div>
        <div class="p-4 rounded-xl bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/60 shadow-sm">
          <p class="text-2xl font-extrabold text-slate-900 dark:text-white">Cloud PMS Ringan</p>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Akses resepsionis & housekeeping via tablet atau HP</p>
        </div>
      </div>

    </div>
  </div>
</section>
