---
import { portfolioData, portfolioLinks } from '../../data/content';
---

<section id="portofolio" class="py-20 md:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 dark:bg-emerald-500/10 border border-emerald-300 dark:border-emerald-500/30 text-emerald-800 dark:text-emerald-400 text-xs font-semibold mb-3">
        <span>Rekayasa Teruji & Siap Pakai</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Studi Kasus & Arsitektur Sistem Properti
      </h2>
      <p class="mt-4 text-base text-slate-600 dark:text-slate-400">
        Jelajahi portofolio solusi hospitality yang kami rancang — mulai dari Direct Booking Engine villa mewah, Cloud PMS resort terintegrasi housekeeping, hingga sistem kasir lounge hotel.
      </p>
    </div>

    <!-- Portfolio Cards Stack -->
    <div class="space-y-12">
      {portfolioData.map((item) => (
        <div class="rounded-3xl bg-white dark:bg-gradient-to-b dark:from-slate-900 dark:to-[#0B0F19] border border-slate-200 dark:border-slate-800 p-8 lg:p-12 shadow-xl dark:shadow-2xl relative overflow-hidden transition-colors duration-300">
          <!-- Ambient Glow -->
          <div class="absolute -right-20 -top-20 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Left Info (7 cols) -->
            <div class="lg:col-span-7 space-y-6">
              <div class="flex flex-wrap items-center gap-3">
                <span class="px-3 py-1 text-xs font-bold bg-emerald-100 dark:bg-emerald-950 border border-emerald-300 dark:border-emerald-500/30 text-emerald-800 dark:text-emerald-300 rounded-lg">
                  {item.category}
                </span>

                <span class="px-3 py-1 text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg border border-slate-200 dark:border-slate-700">
                  {item.propertyType}
                </span>

                {item.isInteractiveDemo && (
                  <span class="flex items-center gap-1.5 text-xs font-bold text-cyan-700 dark:text-cyan-400 bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-300 dark:border-cyan-500/40 px-3 py-1 rounded-lg">
                    <span class="w-2 h-2 rounded-full bg-cyan-500 animate-ping"></span>
                    Live Interactive Demo
                  </span>
                )}
              </div>

              <div>
                <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
                  {item.title}
                </h3>
                <p class="text-xs uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400 mt-1">
                  Klien / Ekosistem: <strong class="text-emerald-600 dark:text-emerald-400">{item.client}</strong>
                </p>
                <p class="mt-4 text-slate-600 dark:text-slate-300 text-base leading-relaxed">
                  {item.description}
                </p>
              </div>

              <!-- Impact Highlight Box -->
              <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800">
                <p class="text-xs uppercase tracking-wider font-bold text-slate-500 dark:text-slate-400">Dampak & Manfaat Nyata:</p>
                <p class="text-sm font-semibold text-emerald-700 dark:text-emerald-300 mt-1">"{item.impact}"</p>
              </div>

              <!-- Features List -->
              <div>
                <p class="text-xs uppercase tracking-wider font-bold text-slate-500 dark:text-slate-400 mb-3">Fitur Utama Sistem:</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                  {item.features.map((feat) => (
                    <div class="flex items-start gap-2 text-xs text-slate-700 dark:text-slate-300">
                      <svg class="w-4 h-4 text-emerald-500 dark:text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <span>{feat}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                {item.id === 'coffee-stand-pos' && (
                  <>
                    <a
                      href="https://coffee-stand-demo.netlify.app/"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-bold text-xs shadow-md shadow-emerald-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all group"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <span>Coba Live Demo POS Lounge</span>
                      <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </a>

                    <a
                      href="#request-builder"
                      class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-semibold text-xs border border-slate-300 dark:border-slate-700 transition-all"
                    >
                      <span>Ajukan Custom POS Resto/Bar</span>
                    </a>
                  </>
                )}

                {item.id === 'pelangi-efrata-supply' && (
                  <>
                    <a
                      href={portfolioLinks.pelangiWebLiveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-md shadow-emerald-600/20 transition-all group"
                    >
                      <span>Kunjungi Website CV Pelangi Efrata</span>
                      <svg class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>

                    <a
                      href="#request-builder"
                      class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-semibold text-xs border border-slate-300 dark:border-slate-700 transition-all"
                    >
                      <span>Konsultasi Sistem Suplai Logistik</span>
                    </a>
                  </>
                )}

                {item.id === 'aura-haven-villa-pms' && (
                  <>
                    <a
                      href="https://cute-liger-eb138a.netlify.app/"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-bold text-xs shadow-md shadow-emerald-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all group"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <span>Buka Live Demo Aura Haven Villa Direct</span>
                      <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </a>

                    <a
                      href="#request-builder"
                      class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-semibold text-xs border border-slate-300 dark:border-slate-700 transition-all"
                    >
                      <span>Ajukan Direct Booking Engine Villa Anda</span>
                    </a>
                  </>
                )}

                {item.id === 'lumina-resort-pms-concierge' && (
                  <>
                    <a
                      href="#request-builder"
                      class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-bold text-xs shadow-md shadow-emerald-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all group"
                    >
                      <span>Ajukan Sistem Cloud PMS Serupa</span>
                      <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </a>

                    <a
                      href="https://wa.me/6282322370126?text=Halo%20Tim%20Veridion,%20saya%20tertarik%20dengan%20sistem%20Lumina%20Eco%20Resort%20PMS" 
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-semibold text-xs border border-slate-300 dark:border-slate-700 transition-all"
                    >
                      <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.966 1.201.664.591 1.224.774 1.397.86.173.086.274.072.375-.044.101-.116.433-.505.549-.679.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z" />
                      </svg>
                      <span>Tanya Alur Teknis via WA</span>
                    </a>
                  </>
                )}
              </div>

              <!-- Notice Box -->
              <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 text-xs space-y-1.5">
                <div class="flex items-center gap-2 text-slate-800 dark:text-slate-200 font-bold">
                  <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <span>Status Sistem: {item.activeStatus}</span>
                </div>
                <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
                  Semua arsitektur di atas dibangun dengan standar modular (Tailwind, Astro/Next.js, Node/Serverless) sehingga dapat langsung diadaptasi dengan brand identity, foto, dan struktur tarif properti Anda.
                </p>
              </div>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2 pt-1">
                {item.tags.map((tag) => (
                  <span class="px-2.5 py-1 text-[11px] font-medium bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 rounded-md border border-slate-200 dark:border-slate-700/50">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Right Metrics & Architecture (5 cols) -->
            <div class="lg:col-span-5 flex flex-col gap-6">
              <div class="grid grid-cols-1 gap-4">
                {item.metrics.map((metric) => (
                  <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 hover:border-emerald-500/40 transition-colors shadow-sm">
                    <p class="text-xs text-slate-500 dark:text-slate-400">{metric.label}</p>
                    <p class="text-2xl sm:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-cyan-600 dark:from-emerald-400 dark:to-cyan-400 mt-1">
                      {metric.value}
                    </p>
                  </div>
                ))}
              </div>

              <!-- Highlight Card -->
              <div class="p-5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-200 dark:border-emerald-500/20 shadow-sm">
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-500/10 flex items-center justify-center text-emerald-600 dark:text-emerald-400 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                  <div class="space-y-1">
                    <p class="text-sm font-bold text-slate-900 dark:text-white">Implementasi Langsung Tanpa Agen Pihak Ketiga</p>
                    <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                      Sistem terhubung langsung ke domain resmi properti Anda, dengan hak milik 100% atas data riwayat tamu untuk strategi direct booking berikutnya.
                    </p>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
