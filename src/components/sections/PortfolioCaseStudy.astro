---
import { portfolioData } from '../../data/content';
const mainCase = portfolioData[0];
---

<section id="portofolio" class="py-20 md:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold mb-3">
        <span>Bukan Mockup Konseptual</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Studi Kasus Nyata: Dipercaya & Digunakan Harian
      </h2>
      <p class="mt-4 text-base text-slate-400">
        Lihat bagaimana solusi software kustom kami membantu klien mentransformasi operasional kasir dan citra bisnis mereka secara konkret.
      </p>
    </div>

    <!-- Case Study Card -->
    <div class="rounded-3xl bg-gradient-to-b from-slate-900 to-[#0B0F19] border border-slate-800 p-8 lg:p-12 shadow-2xl relative overflow-hidden">
      <!-- Ambient Glow -->
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Text & Specs (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="flex flex-wrap items-center gap-3">
            <span class="px-3 py-1 text-xs font-bold bg-emerald-950 border border-emerald-500/30 text-emerald-300 rounded-lg">
              {mainCase.category}
            </span>
            <span class="flex items-center gap-1.5 text-xs font-semibold text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-lg">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              {mainCase.activeStatus}
            </span>
          </div>

          <div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-white">
              {mainCase.client} — {mainCase.title}
            </h3>
            <p class="mt-4 text-slate-300 text-base leading-relaxed">
              {mainCase.description}
            </p>
          </div>

          <!-- Impact Highlight Box -->
          <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800">
            <p class="text-xs uppercase tracking-wider font-bold text-slate-400">Dampak Nyata Lapangan:</p>
            <p class="text-sm font-semibold text-emerald-300 mt-1">"{mainCase.impact}"</p>
          </div>

          <!-- Features List -->
          <div>
            <p class="text-xs uppercase tracking-wider font-bold text-slate-400 mb-3">Fitur Utama Sistem:</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              {mainCase.features.map((feat) => (
                <div class="flex items-start gap-2 text-xs text-slate-300">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>{feat}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2 pt-2">
            {mainCase.tags.map((tag) => (
              <span class="px-2.5 py-1 text-[11px] font-medium bg-slate-800/80 text-slate-300 rounded-md border border-slate-700/50">
                #{tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Metric Showcase & Visual Dashboard (5 cols) -->
        <div class="lg:col-span-5 flex flex-col gap-6">
          <div class="grid grid-cols-1 gap-4">
            {mainCase.metrics.map((metric) => (
              <div class="p-5 rounded-2xl bg-slate-950/80 border border-slate-800 hover:border-emerald-500/40 transition-colors">
                <p class="text-xs text-slate-400">{metric.label}</p>
                <p class="text-2xl sm:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400 mt-1">
                  {metric.value}
                </p>
              </div>
            ))}
          </div>

          <!-- System Architecture Badge -->
          <div class="p-5 rounded-2xl bg-emerald-950/20 border border-emerald-500/20">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-bold text-white">Standar Kualitas Produksi</p>
                <p class="text-xs text-slate-400">Dukungan kustomisasi alur bisnis, backup data teratur, dan antarmuka responsif.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

