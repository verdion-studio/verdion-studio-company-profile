<header class="sticky top-0 z-50 backdrop-blur-md bg-[#0B0F19]/80 border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Logo & Brand -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-cyan-500 p-0.5 shadow-lg shadow-emerald-500/20 group-hover:shadow-emerald-500/40 transition-all duration-300">
        <div class="w-full h-full bg-[#0B0F19] rounded-[10px] flex items-center justify-center font-bold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400 text-lg">
          V
        </div>
      </div>
      <div class="flex flex-col">
        <span class="text-xl font-bold tracking-tight text-white group-hover:text-emerald-400 transition-colors">
          Veridion <span class="text-emerald-400 font-extrabold">Studio</span>
        </span>
        <span class="text-[10px] uppercase tracking-widest text-slate-400 font-medium">Software House</span>
      </div>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
      <a href="#solusi" class="hover:text-emerald-400 transition-colors">Solusi Industri</a>
      <a href="#portofolio" class="hover:text-emerald-400 transition-colors">Portofolio</a>
      <a href="#early-partner" class="hover:text-emerald-400 transition-colors flex items-center gap-2">
        <span>Early Partner</span>
        <span class="px-2 py-0.5 text-[10px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-full font-bold animate-pulse">
          3 Slot Gratis
        </span>
      </a>
      <a href="#request-builder" class="hover:text-emerald-400 transition-colors">Rancang App</a>
    </nav>

    <!-- Action Button -->
    <div class="flex items-center gap-3">
      <a
        href="#request-builder"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-bold text-sm shadow-md shadow-emerald-500/20 hover:shadow-emerald-500/40 hover:opacity-95 transition-all duration-200"
      >
        <span>Konsultasi Proyek</span>
      </a>
    </div>
  </div>
</header>

