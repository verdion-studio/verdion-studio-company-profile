---
import { ui, type Language } from '../../i18n/ui';

interface Props {
  lang?: Language;
}

const { lang = 'id' } = Astro.props;
const t = ui[lang].nav;
const homeUrl = lang === 'en' ? '/en' : '/';
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-white/90 dark:bg-[#070A12]/90 border-b border-slate-200/80 dark:border-slate-800/80 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 sm:h-20 flex items-center justify-between gap-4">
    
    <!-- Logo & Brand -->
    <a href={homeUrl} class="flex items-center gap-2.5 sm:gap-3 group shrink-0 select-none">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-cyan-500 p-0.5 shadow-lg shadow-emerald-500/20 group-hover:shadow-emerald-500/40 transition-all duration-300 shrink-0">
        <div class="w-full h-full bg-white dark:bg-[#070A12] rounded-[10px] flex items-center justify-center font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 to-cyan-500 text-base sm:text-lg">
          V
        </div>
      </div>
      <div class="flex flex-col">
        <span class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white group-hover:text-emerald-500 transition-colors whitespace-nowrap">
          Veridion <span class="text-emerald-500 dark:text-emerald-400 font-black">Studio</span>
        </span>
        <span class="text-[9px] sm:text-[10px] uppercase tracking-widest text-slate-500 dark:text-slate-400 font-semibold whitespace-nowrap">
          Hospitality Tech Studio
        </span>
      </div>
    </a>

    <!-- Nav Links (Desktop — hidden below xl to guarantee 0 text-wrapping) -->
    <nav class="hidden xl:flex items-center gap-5 2xl:gap-7 text-[13px] 2xl:text-sm font-semibold tracking-tight text-slate-600 dark:text-slate-300 whitespace-nowrap">
      <a href="#solusi" class="whitespace-nowrap hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors py-1">
        {t.solusi}
      </a>
      <a href="#portofolio" class="whitespace-nowrap hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors py-1">
        {t.portofolio}
      </a>
      <a href="#kalkulator-roi" class="whitespace-nowrap hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors flex items-center gap-1.5 py-1">
        <span>{t.kalkulator}</span>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      </a>
      <a href="#arsitektur-teknologi" class="whitespace-nowrap hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors py-1">
        {t.standar}
      </a>
      <a href="#early-partner" class="whitespace-nowrap hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors flex items-center gap-1.5 py-1 group/pilot">
        <span>{t.pilot}</span>
        <span class="px-2 py-0.5 text-[10px] bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-500/30 rounded-full font-bold group-hover/pilot:border-emerald-400 transition-colors">
          {t.pilotBadge}
        </span>
      </a>
      <a href="#request-builder" class="whitespace-nowrap hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors py-1">
        {t.rancang}
      </a>
    </nav>

    <!-- Right Controls: Language Switcher, Theme Toggle, CTA, & Mobile Hamburger -->
    <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
      
      <!-- Language Switcher Pill (ID | EN) -->
      <div class="flex items-center rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900/90 p-0.5 text-xs font-bold shrink-0 select-none" aria-label="Pilih Bahasa / Select Language">
        <a
          href="/"
          class={`px-2 py-1 rounded-lg text-[11px] font-bold transition-all ${lang === 'id' ? 'bg-white dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 shadow-sm' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white'}`}
          title="Bahasa Indonesia"
        >
          ID
        </a>
        <a
          href="/en"
          class={`px-2 py-1 rounded-lg text-[11px] font-bold transition-all ${lang === 'en' ? 'bg-white dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 shadow-sm' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white'}`}
          title="English"
        >
          EN
        </a>
      </div>

      <!-- Dark / Light Mode Switcher Button -->
      <button
        id="themeToggleBtn"
        type="button"
        aria-label={t.themeAria}
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900/90 text-slate-700 dark:text-slate-200 hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors cursor-pointer flex items-center justify-center shrink-0"
      >
        <!-- Sun Icon (Shown in Dark Mode) -->
        <svg id="sunIcon" class="w-4 h-4 sm:w-4.5 sm:h-4.5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (Shown in Light Mode) -->
        <svg id="moonIcon" class="w-4 h-4 sm:w-4.5 sm:h-4.5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- CTA (Desktop & Tablet — whitespace-nowrap prevents line-breaks) -->
      <a
        href="#request-builder"
        class="hidden sm:inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-bold text-xs sm:text-sm shadow-md shadow-emerald-500/20 hover:shadow-emerald-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all whitespace-nowrap shrink-0"
      >
        <span>{t.cta}</span>
      </a>

      <!-- Mobile Menu Hamburger Button (shown below xl) -->
      <button
        id="mobileMenuToggleBtn"
        type="button"
        aria-label={t.mobileMenuAria}
        aria-expanded="false"
        class="xl:hidden w-9 h-9 sm:w-10 sm:h-10 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors flex items-center justify-center shrink-0 cursor-pointer"
      >
        <svg id="hamburgerIcon" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="closeMenuIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Full UX polish with backdrop, icons & quick actions) -->
  <div
    id="mobileMenuDropdown"
    class="hidden xl:hidden border-t border-slate-200/90 dark:border-slate-800/90 bg-white/95 dark:bg-[#070A12]/95 backdrop-blur-2xl transition-all duration-300 shadow-2xl"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 space-y-4">
      
      <!-- Mobile Quick Top Row -->
      <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800/80">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
            {lang === 'en' ? 'Direct Tech Lead Support' : 'Diskusi Langsung Tech Lead'}
          </span>
        </div>
        <div class="flex items-center rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 p-0.5 text-xs font-bold">
          <a href="/" class={`px-2.5 py-1 rounded-md transition-all ${lang === 'id' ? 'bg-white dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 shadow-sm' : 'text-slate-500'}`}>ID</a>
          <a href="/en" class={`px-2.5 py-1 rounded-md transition-all ${lang === 'en' ? 'bg-white dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 shadow-sm' : 'text-slate-500'}`}>EN</a>
        </div>
      </div>

      <!-- Navigation Links List with Icons -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        
        <a
          href="#solusi"
          class="mobile-nav-link flex items-center gap-3 p-3 rounded-xl border border-transparent hover:border-slate-200 dark:hover:border-slate-800 bg-slate-50/60 dark:bg-slate-900/40 hover:bg-emerald-50/60 dark:hover:bg-slate-800/60 transition-all text-slate-800 dark:text-slate-200 group"
        >
          <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div>
            <span class="block text-sm font-bold group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
              {t.solusi}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">
              {lang === 'en' ? 'Villa, Boutique Hotel & Resort Modules' : 'Modul Khusus Villa, Hotel & Resort'}
            </span>
          </div>
        </a>

        <a
          href="#portofolio"
          class="mobile-nav-link flex items-center gap-3 p-3 rounded-xl border border-transparent hover:border-slate-200 dark:hover:border-slate-800 bg-slate-50/60 dark:bg-slate-900/40 hover:bg-emerald-50/60 dark:hover:bg-slate-800/60 transition-all text-slate-800 dark:text-slate-200 group"
        >
          <div class="w-8 h-8 rounded-lg bg-cyan-100 dark:bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <span class="block text-sm font-bold group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
              {t.portofolio}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">
              {lang === 'en' ? 'Aura Haven Villa & Live Demos' : 'Aura Haven & Live Interactive Demo'}
            </span>
          </div>
        </a>

        <a
          href="#kalkulator-roi"
          class="mobile-nav-link flex items-center gap-3 p-3 rounded-xl border border-transparent hover:border-slate-200 dark:hover:border-slate-800 bg-slate-50/60 dark:bg-slate-900/40 hover:bg-emerald-50/60 dark:hover:bg-slate-800/60 transition-all text-slate-800 dark:text-slate-200 group"
        >
          <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="flex-1">
            <div class="flex items-center justify-between">
              <span class="text-sm font-bold group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                {t.kalkulator}
              </span>
              <span class="px-2 py-0.5 text-[10px] bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 font-bold rounded">
                ROI Tool
              </span>
            </div>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">
              {lang === 'en' ? 'Calculate 18% OTA commission savings' : 'Simulasi margin 18% komisi OTA bulanan'}
            </span>
          </div>
        </a>

        <a
          href="#arsitektur-teknologi"
          class="mobile-nav-link flex items-center gap-3 p-3 rounded-xl border border-transparent hover:border-slate-200 dark:hover:border-slate-800 bg-slate-50/60 dark:bg-slate-900/40 hover:bg-emerald-50/60 dark:hover:bg-slate-800/60 transition-all text-slate-800 dark:text-slate-200 group"
        >
          <div class="w-8 h-8 rounded-lg bg-teal-100 dark:bg-teal-500/20 text-teal-600 dark:text-teal-400 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <span class="block text-sm font-bold group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
              {t.standar}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">
              {lang === 'en' ? '2-Way iCal Sync & Direct Payments' : 'Sync iCal, Payment Direct & CRM Data'}
            </span>
          </div>
        </a>

        <a
          href="#early-partner"
          class="mobile-nav-link flex items-center gap-3 p-3 rounded-xl border border-emerald-300/40 dark:border-emerald-500/30 bg-emerald-50/50 dark:bg-emerald-950/20 hover:bg-emerald-100/60 dark:hover:bg-emerald-950/40 transition-all text-slate-800 dark:text-slate-200 group"
        >
          <div class="w-8 h-8 rounded-lg bg-emerald-500 text-slate-950 flex items-center justify-center shrink-0 font-bold">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
          </div>
          <div class="flex-1">
            <div class="flex items-center justify-between">
              <span class="text-sm font-extrabold text-emerald-800 dark:text-emerald-300">
                {t.pilot}
              </span>
              <span class="px-2 py-0.5 text-[10px] bg-emerald-200 dark:bg-emerald-500/30 text-emerald-900 dark:text-emerald-200 font-extrabold rounded-full">
                {lang === 'en' ? '2 Free Slots (T&Cs)' : '2 Slot Gratis (S&K)'}
              </span>
            </div>
            <span class="text-[11px] text-emerald-700 dark:text-emerald-400">
              {lang === 'en' ? 'Mutual credibility partnership' : 'Program kemitraan timbal balik reputasi'}
            </span>
          </div>
        </a>

        <a
          href="#request-builder"
          class="mobile-nav-link flex items-center gap-3 p-3 rounded-xl border border-transparent hover:border-slate-200 dark:hover:border-slate-800 bg-slate-50/60 dark:bg-slate-900/40 hover:bg-emerald-50/60 dark:hover:bg-slate-800/60 transition-all text-slate-800 dark:text-slate-200 group"
        >
          <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-500/20 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
          </div>
          <div>
            <span class="block text-sm font-bold group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
              {t.rancang}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">
              {lang === 'en' ? 'Custom spec builder to WhatsApp & Email' : 'Rancang kebutuhan modul properti Anda'}
            </span>
          </div>
        </a>

      </div>

      <!-- Action Buttons Row in Mobile Drawer -->
      <div class="pt-2 space-y-2.5">
        <a
          href="https://wa.me/6282322370126?text=Halo%20Tim%20Veridion,%20saya%20ingin%20konsultasi%20mengenai%20sistem%20properti"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2.5 px-5 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-extrabold text-sm shadow-lg shadow-emerald-500/20 hover:scale-[1.01] active:scale-[0.99] transition-all"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.966 1.201.664.591 1.224.774 1.397.86.173.086.274.072.375-.044.101-.116.433-.505.549-.679.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z" />
          </svg>
          <span>{lang === 'en' ? 'Chat Direct with Tech Lead (WhatsApp)' : 'Konsultasi via WhatsApp (Tech Lead)'}</span>
        </a>

        <a
          href="https://cute-liger-eb138a.netlify.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-xs font-bold text-slate-800 dark:text-slate-200 hover:text-emerald-500 transition-colors"
        >
          <span>{lang === 'en' ? 'Launch Live Demo: Aura Haven Villa' : 'Buka Live Demo Aura Haven Villa'}</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</header>

<script is:inline>
  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    const sunIcon = document.getElementById('sunIcon');
    const moonIcon = document.getElementById('moonIcon');

    if (sunIcon && moonIcon) {
      if (isDark) {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      }
    }
  }

  function setupThemeToggle() {
    const btn = document.getElementById('themeToggleBtn');
    if (!btn) return;

    updateThemeUI();

    btn.onclick = function() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
      updateThemeUI();
    };
  }

  function setupMobileMenu() {
    const mobileBtn = document.getElementById('mobileMenuToggleBtn');
    const dropdown = document.getElementById('mobileMenuDropdown');
    const hamburgerIcon = document.getElementById('hamburgerIcon');
    const closeMenuIcon = document.getElementById('closeMenuIcon');

    if (!mobileBtn || !dropdown || !hamburgerIcon || !closeMenuIcon) return;

    function openMenu() {
      dropdown.classList.remove('hidden');
      hamburgerIcon.classList.add('hidden');
      closeMenuIcon.classList.remove('hidden');
      mobileBtn.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      dropdown.classList.add('hidden');
      hamburgerIcon.classList.remove('hidden');
      closeMenuIcon.classList.add('hidden');
      mobileBtn.setAttribute('aria-expanded', 'false');
    }

    mobileBtn.onclick = function() {
      const isOpen = !dropdown.classList.contains('hidden');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    };

    // Close menu when clicking any mobile link
    const links = dropdown.querySelectorAll('.mobile-nav-link');
    links.forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Close menu on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !dropdown.classList.contains('hidden')) {
        closeMenu();
      }
    });
  }

  setupThemeToggle();
  setupMobileMenu();
</script>
