---
---

<section id="kalkulator-roi" class="py-20 md:py-28 relative bg-gradient-to-b from-slate-50 via-emerald-50/40 to-slate-50 dark:from-[#0B0F19] dark:via-emerald-950/20 dark:to-[#0B0F19] border-y border-emerald-500/20 transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 dark:bg-emerald-500/10 border border-emerald-300 dark:border-emerald-500/30 text-emerald-800 dark:text-emerald-400 text-xs font-semibold mb-3">
        <span>Simulasi Nilai Bisnis & Profitabilitas</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Kalkulator Penghematan Komisi OTA & ROI Properti
      </h2>
      <p class="mt-4 text-base text-slate-600 dark:text-slate-400">
        Berapa banyak profit yang terbuang ke komisi 18% OTA (Airbnb, Agoda, Booking.com) setiap bulan? Hitung sendiri potensi margin yang dapat Anda selamatkan dengan Direct Booking Engine mandiri.
      </p>
    </div>

    <!-- Calculator Card -->
    <div class="rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 sm:p-10 lg:p-12 shadow-2xl relative overflow-hidden transition-colors">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Controls Left (7 Cols) -->
        <div class="lg:col-span-7 space-y-7">
          
          <!-- Slider 1: Jumlah Unit/Kamar -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label for="roomCount" class="text-sm font-bold text-slate-900 dark:text-white">
                Jumlah Kamar / Unit Villa
              </label>
              <span id="roomCountLabel" class="text-base font-extrabold text-emerald-600 dark:text-emerald-400">8 Unit</span>
            </div>
            <input
              type="range"
              id="roomCount"
              min="1"
              max="40"
              step="1"
              value="8"
              class="w-full accent-emerald-500 cursor-pointer h-2 bg-slate-200 dark:bg-slate-700 rounded-lg"
            />
            <div class="flex justify-between text-[11px] text-slate-400">
              <span>1 Unit (Private Villa)</span>
              <span>20 Unit</span>
              <span>40+ Unit (Hotel/Resort)</span>
            </div>
          </div>

          <!-- Slider 2: Average Daily Rate (ADR) -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label for="adrRate" class="text-sm font-bold text-slate-900 dark:text-white">
                Rata-rata Tarif Per Malam (ADR)
              </label>
              <span id="adrRateLabel" class="text-base font-extrabold text-emerald-600 dark:text-emerald-400">Rp 850.000</span>
            </div>
            <input
              type="range"
              id="adrRate"
              min="200000"
              max="5000000"
              step="50000"
              value="850000"
              class="w-full accent-emerald-500 cursor-pointer h-2 bg-slate-200 dark:bg-slate-700 rounded-lg"
            />
            <div class="flex justify-between text-[11px] text-slate-400">
              <span>Rp 200 Rb</span>
              <span>Rp 2,5 Jt</span>
              <span>Rp 5 Jt+ (Luxury Villa)</span>
            </div>
          </div>

          <!-- Slider 3: Okupansi -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label for="occupancyRate" class="text-sm font-bold text-slate-900 dark:text-white">
                Tingkat Okupansi Rata-rata Bulanan
              </label>
              <span id="occupancyRateLabel" class="text-base font-extrabold text-emerald-600 dark:text-emerald-400">70%</span>
            </div>
            <input
              type="range"
              id="occupancyRate"
              min="20"
              max="100"
              step="5"
              value="70"
              class="w-full accent-emerald-500 cursor-pointer h-2 bg-slate-200 dark:bg-slate-700 rounded-lg"
            />
            <div class="flex justify-between text-[11px] text-slate-400">
              <span>20% (Low)</span>
              <span>60% (Moderate)</span>
              <span>100% (High Season)</span>
            </div>
          </div>

          <!-- Slider 4: Porsi Pemesanan OTA -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label for="otaShare" class="text-sm font-bold text-slate-900 dark:text-white">
                Porsi Tamu yang Masuk via OTA (Saat Ini)
              </label>
              <span id="otaShareLabel" class="text-base font-extrabold text-cyan-600 dark:text-cyan-400">80% via OTA</span>
            </div>
            <input
              type="range"
              id="otaShare"
              min="20"
              max="100"
              step="5"
              value="80"
              class="w-full accent-cyan-500 cursor-pointer h-2 bg-slate-200 dark:bg-slate-700 rounded-lg"
            />
            <div class="flex justify-between text-[11px] text-slate-400">
              <span>20% OTA</span>
              <span>50% OTA</span>
              <span>100% Ketergantungan OTA</span>
            </div>
          </div>

        </div>

        <!-- Result Box Right (5 Cols) -->
        <div class="lg:col-span-5">
          <div class="rounded-2xl bg-gradient-to-br from-slate-900 to-slate-950 text-white p-7 sm:p-8 border border-emerald-500/30 shadow-xl space-y-6">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">
                Estimasi Komisi OTA Terbuang:
              </span>
              <p id="monthlyOtaFee" class="text-3xl sm:text-4xl font-extrabold text-red-400 mt-1">
                Rp 20.563.200
              </p>
              <p class="text-xs text-slate-400 mt-1">
                Potongan komisi rata-rata 18% dari OTA setiap bulan.
              </p>
            </div>

            <div class="pt-4 border-t border-slate-800">
              <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">
                Potensi Penghematan Tahunan:
              </span>
              <p id="yearlySavings" class="text-2xl sm:text-3xl font-extrabold text-emerald-400 mt-1">
                Rp 246.758.400 / Tahun
              </p>
              <p class="text-xs text-slate-300 mt-1">
                Nilai profit bersih yang kembali ke kantong pemilik properti dengan sistem Direct Booking mandiri.
              </p>
            </div>

            <div class="pt-2">
              <div class="p-3.5 rounded-xl bg-emerald-950/50 border border-emerald-500/30 text-xs text-emerald-200">
                <span class="font-bold">✓ 100% Pembayaran Masuk ke Rekening Anda</span>
                <p class="text-[11px] text-slate-300 mt-0.5">Tanpa fee transaksi per pemesanan, tanpa penahanan dana, dan data kontak tamu milik Anda seutuhnya.</p>
              </div>
            </div>

            <a
              href="#request-builder"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-bold text-sm shadow-lg shadow-emerald-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all"
            >
              <span>Selamatkan Margin Properti Saya</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script is:inline>
  function setupOtaCalculator() {
    const roomInput = document.getElementById('roomCount');
    const adrInput = document.getElementById('adrRate');
    const occupancyInput = document.getElementById('occupancyRate');
    const otaShareInput = document.getElementById('otaShare');

    const roomLabel = document.getElementById('roomCountLabel');
    const adrLabel = document.getElementById('adrRateLabel');
    const occupancyLabel = document.getElementById('occupancyRateLabel');
    const otaShareLabel = document.getElementById('otaShareLabel');

    const monthlyFeeEl = document.getElementById('monthlyOtaFee');
    const yearlySavingsEl = document.getElementById('yearlySavings');

    if (!roomInput || !adrInput || !occupancyInput || !otaShareInput) return;

    function formatRupiah(num) {
      return 'Rp ' + Math.round(num).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    }

    function calculate() {
      const rooms = parseInt(roomInput.value, 10);
      const adr = parseInt(adrInput.value, 10);
      const occPercent = parseInt(occupancyInput.value, 10) / 100;
      const otaPercent = parseInt(otaShareInput.value, 10) / 100;

      // Update Labels
      roomLabel.textContent = `${rooms} Unit`;
      adrLabel.textContent = formatRupiah(adr);
      occupancyLabel.textContent = `${Math.round(occPercent * 100)}%`;
      otaShareLabel.textContent = `${Math.round(otaPercent * 100)}% via OTA`;

      // 30 days per month
      const totalAvailableRoomNights = rooms * 30;
      const bookedRoomNights = totalAvailableRoomNights * occPercent;
      const totalRevenueMonthly = bookedRoomNights * adr;

      const otaRevenueMonthly = totalRevenueMonthly * otaPercent;
      const otaCommissionRate = 0.18; // 18% standard OTA commission
      const monthlyOtaLoss = otaRevenueMonthly * otaCommissionRate;
      const yearlySavings = monthlyOtaLoss * 12;

      monthlyFeeEl.textContent = formatRupiah(monthlyOtaLoss);
      yearlySavingsEl.textContent = `${formatRupiah(yearlySavings)} / Tahun`;
    }

    roomInput.addEventListener('input', calculate);
    adrInput.addEventListener('input', calculate);
    occupancyInput.addEventListener('input', calculate);
    otaShareInput.addEventListener('input', calculate);

    calculate();
  }

  setupOtaCalculator();
</script>
